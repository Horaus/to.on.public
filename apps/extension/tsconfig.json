{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome"],
    "lib": ["DOM", "ES2022"],
    "baseUrl": ".",
    "paths": {
      "@studio/types": ["../../packages/types/src/index.ts"],
      "@studio/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
