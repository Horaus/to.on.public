{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@studio/types": ["packages/types/src/index.ts"],
      "@studio/types/job-request": ["packages/types/src/job-request.ts"],
      "@studio/protocol": ["packages/protocol/src/index.ts"],
      "@studio/protocol/duration-policy": ["packages/protocol/src/duration-policy.ts"],
      "@studio/protocol/job-request": ["packages/protocol/src/job-request.ts"],
      "@studio/domain": ["packages/domain/src/index.ts"],
      "@studio/domain/pipeline-gates": ["packages/domain/src/pipeline-gates.ts"],
      "@studio/domain/duration-policy": ["packages/domain/src/duration-policy.ts"],
      "@studio/domain/shot-classification": ["packages/domain/src/shot-classification.ts"],
      "@studio/domain/text-support": ["packages/domain/src/text-support.ts"],
      "@studio/domain/labels": ["packages/domain/src/labels.ts"],
      "@studio/domain/layout": ["packages/domain/src/layout.ts"],
      "@studio/domain/identifiers": ["packages/domain/src/identifiers.ts"],
      "@studio/domain/preflight-contract": ["packages/domain/src/preflight-contract.ts"],
      "@studio/domain/conversation-url": ["packages/domain/src/conversation-url.cjs"],
      "@studio/domain/job-contracts": ["packages/domain/src/job-contracts.ts"],
      "@studio/production-graph": ["packages/production-graph/src/index.ts"],
      "@studio/production-graph/contracts": ["packages/production-graph/src/contracts.ts"],
      "@studio/workflow/*": ["packages/workflow/src/*"],
      "@studio/renderer-core/*": ["packages/renderer/src/core/*"]
    }
  },
  "include": ["apps/desktop/src", "packages/**/*"]
}
